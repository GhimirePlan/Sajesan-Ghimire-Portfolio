    "autoprefixer": "^10.4.13",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.21",
    "prettier": "^3.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.2.6",
    "typescript": "^5.2.2",
    "vite": "^8.3.8"
